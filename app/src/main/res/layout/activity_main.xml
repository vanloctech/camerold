<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">

    <!-- Header: logo, app name + tagline, settings -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingStart="@dimen/card_pad" android:paddingEnd="8dp"
        android:paddingTop="12dp" android:paddingBottom="8dp">
        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@mipmap/ic_launcher"
            android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView style="@style/T.Title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="22sp" android:textStyle="bold" android:text="@string/app_name" />
            <TextView style="@style/T.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="@string/home_tagline" />
        </LinearLayout>
        <ImageButton android:id="@+id/btnSettings" style="@style/BarButton" android:src="@drawable/ic_settings"
            android:contentDescription="@string/settings_title" />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingStart="@dimen/screen_pad" android:paddingEnd="@dimen/screen_pad" android:paddingBottom="24dp">

            <TextView style="@style/T.Display" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:paddingStart="4dp" android:paddingEnd="4dp"
                android:lineSpacingExtra="2dp" android:text="@string/home_question" />

            <!-- The two roles -->
            <include android:id="@+id/roleCamera" layout="@layout/home_role" android:layout_width="match_parent"
                android:layout_height="148dp" android:layout_marginTop="20dp" />
            <include android:id="@+id/roleViewer" layout="@layout/home_role" android:layout_width="match_parent"
                android:layout_height="148dp" android:layout_marginTop="12dp" />

            <TextView style="@style/SectionTitle" android:text="@string/home_how" />
            <LinearLayout android:id="@+id/howCard" style="@style/Card" android:paddingTop="6dp" android:paddingBottom="6dp" />

            <TextView style="@style/Note" android:layout_marginTop="16dp" android:gravity="center"
                android:text="@string/home_footer" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
