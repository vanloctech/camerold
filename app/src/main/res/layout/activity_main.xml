<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">

    <!-- Header: app name + settings -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingStart="@dimen/card_pad" android:paddingEnd="8dp">
        <TextView style="@style/T.Display" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="@string/app_name" />
        <ImageButton android:id="@+id/btnSettings" style="@style/BarButton" android:src="@drawable/ic_settings"
            android:contentDescription="@string/settings_title" />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingStart="@dimen/screen_pad" android:paddingEnd="@dimen/screen_pad" android:paddingBottom="24dp">

            <TextView style="@style/T.Value" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingStart="4dp" android:paddingEnd="4dp" android:text="@string/home_question_sub2" />

            <!-- The two roles, as tiles -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="176dp" android:layout_marginTop="16dp"
                android:orientation="horizontal">
                <include android:id="@+id/tileCamera" layout="@layout/tile" />
                <View android:layout_width="12dp" android:layout_height="match_parent" />
                <include android:id="@+id/tileViewer" layout="@layout/tile" />
            </LinearLayout>

            <TextView style="@style/SectionTitle" android:text="@string/home_how" />
            <LinearLayout android:id="@+id/howCard" style="@style/Card" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
