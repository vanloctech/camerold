<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text2</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
    </style>
    <style name="AppDialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColorPrimary">@color/text</item>
    </style>
    <!-- The viewer page sets the bar colors itself (black under video), see ViewerActivity.applyBars -->
    <style name="ViewerTheme" parent="AppTheme" />

    <!-- Type scale (all text uses one of these; includeFontPadding off so text lines up with icons) -->
    <style name="T">
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="T.Display"><item name="android:textSize">28sp</item><item name="android:fontFamily">sans-serif-medium</item><item name="android:textStyle">bold</item></style>
    <style name="T.Title"><item name="android:textSize">20sp</item><item name="android:fontFamily">sans-serif-medium</item></style>
    <style name="T.Section"><item name="android:textSize">15sp</item><item name="android:fontFamily">sans-serif-medium</item><item name="android:textStyle">bold</item></style>
    <style name="T.TileTitle"><item name="android:textSize">16sp</item><item name="android:fontFamily">sans-serif-medium</item></style>
    <style name="T.Body"><item name="android:textSize">16sp</item></style>
    <style name="T.Value"><item name="android:textSize">14sp</item><item name="android:textColor">@color/text2</item></style>
    <style name="T.Caption"><item name="android:textSize">13sp</item><item name="android:textColor">@color/text2</item><item name="android:lineSpacingExtra">3dp</item></style>

    <!-- Group label above a card, aligned with the card's inner padding -->
    <style name="SectionTitle" parent="T.Section">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/section_gap</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:paddingStart">@dimen/card_pad</item>
        <item name="android:paddingEnd">@dimen/card_pad</item>
    </style>
    <!-- Small explanation under a card, aligned with the card text -->
    <style name="Note" parent="T.Caption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:paddingStart">@dimen/card_pad</item>
        <item name="android:paddingEnd">@dimen/card_pad</item>
    </style>
    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:orientation">vertical</item>
    </style>
    <!-- Top app bar icon button: 48dp touch target -->
    <style name="BarButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/bg_round_ripple</item>
        <item name="android:tint">@color/text</item>
    </style>
</resources>
